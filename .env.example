# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=
# Application ID (Developer Portal -> General Information)
CLIENT_ID=
# Optional: register slash commands to a single server (instant). Leave empty for global (can take up to 1h).
GUILD_ID=
# SQLite file location
DB_PATH=./data/discoforge.db
# Seconds before the bot deletes its own "wrong channel usage" replies. 0 = never.
WARNING_DELETE_SECONDS=30
